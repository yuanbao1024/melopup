# ===== 本地开发环境变量 =====
# 这些变量仅在本地开发时使用，生产环境在 Vercel 后台配置（无 VITE_ 前缀）
# 浏览器中不再暴露任何密钥，所有 AI 和网易云请求都通过后端代理

# AI API 配置（用于本地后端代理，不做 Vite 编译进前端）
VITE_OPENAI_API_KEY=你的DeepSeek密钥
VITE_OPENAI_BASE_URL=https://api.deepseek.com/v1
VITE_OPENAI_MODEL=deepseek-v4-flash

# 网易云 Cookie（用于本地后端代理）
VITE_NETEASE_COOKIE=你的网易云Cookie
